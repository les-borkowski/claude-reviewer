diff --git a/wordstats.py b/wordstats.py
index c340db5..52f8272 100644
--- a/wordstats.py
+++ b/wordstats.py
@@ -3,3 +3,31 @@
 
 def tokenize(text):
     return [w.strip(".,!?;:").lower() for w in text.split() if w.strip(".,!?;:")]
+
+
+def word_counts(text):
+    counts = {}
+    for word in tokenize(text):
+        if word in counts:
+            counts[word] = counts[word] + 1
+        else:
+            counts[word] = 1
+    return counts
+
+
+class Report:
+    def __init__(self, title):
+        self._title = title
+
+    def get_title(self):
+        return self._title
+
+    def set_title(self, title):
+        self._title = title
+
+    def render(self, text):
+        counts = word_counts(text)
+        lines = [self.get_title()]
+        for word in sorted(counts):
+            lines.append(f"{word}: {counts[word]}")
+        return "\n".join(lines)
