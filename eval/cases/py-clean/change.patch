diff --git a/slugs.py b/slugs.py
index 8a022f0..3c38fcc 100644
--- a/slugs.py
+++ b/slugs.py
@@ -3,3 +3,12 @@ import re
 
 def slugify(text):
     return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
+
+
+def unique_slug(text, taken):
+    """Slug for text that is not in `taken`, adding -2, -3, ... on collision."""
+    base = slugify(text)
+    slug, n = base, 2
+    while slug in taken:
+        slug, n = f"{base}-{n}", n + 1
+    return slug
