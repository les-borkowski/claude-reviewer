diff --git a/src/main/java/shop/Checkout.java b/src/main/java/shop/Checkout.java
index b0f92d5..903a604 100644
--- a/src/main/java/shop/Checkout.java
+++ b/src/main/java/shop/Checkout.java
@@ -3,7 +3,13 @@ package shop;
 import java.util.List;
 
 public class Checkout {
+    private final DiscountService discounts = new DiscountServiceImpl();
+
     public long total(List<Order> orders) {
         return orders.stream().mapToLong(Order::totalCents).sum();
     }
+
+    public long payable(List<Order> orders) {
+        return discounts.apply(total(orders));
+    }
 }
