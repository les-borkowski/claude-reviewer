diff --git a/src/main/java/shop/DiscountServiceImpl.java b/src/main/java/shop/DiscountServiceImpl.java
new file mode 100644
index 0000000..111b101
--- /dev/null
+++ b/src/main/java/shop/DiscountServiceImpl.java
@@ -0,0 +1,10 @@
+package shop;
+
+public class DiscountServiceImpl implements DiscountService {
+    private static final long THRESHOLD_CENTS = 10_000;
+
+    @Override
+    public long apply(long totalCents) {
+        return totalCents >= THRESHOLD_CENTS ? totalCents * 9 / 10 : totalCents;
+    }
+}
